# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tolvink

# JWT
JWT_SECRET=change-this-to-64-random-chars-in-production
JWT_EXPIRES_IN=24h

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,https://tolvink.vercel.app

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# WhatsApp Business API (optional — Meta Cloud API)
# WHATSAPP_PHONE_NUMBER_ID=   # from Meta Developer dashboard
# WHATSAPP_ACCESS_TOKEN=       # System User token (permanent)
# WHATSAPP_VERIFY_TOKEN=       # custom string for webhook verification
# WHATSAPP_APP_SECRET=         # for HMAC signature verification
