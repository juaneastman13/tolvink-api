# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tolvink

# Database (direct connection for migrations/schema push)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tolvink
GOOGLE_MAPS_API_KEY=

# JWT
JWT_SECRET=change-this-to-64-random-chars-in-production
JWT_EXPIRES_IN=24h

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,https://tolvink.com
FRONTEND_URL=https://tolvink.com
# Public URL where this Nest API is reachable. Used for WhatsApp map/location links.
# In Railway this can be the service domain, e.g. https://tolvink-api-production.up.railway.app
API_PUBLIC_URL=https://tolvink-api-production.up.railway.app

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# WhatsApp via Meta Cloud API (optional)
# WHATSAPP_PHONE_NUMBER_ID=    # from developers.facebook.com > WhatsApp > API Setup
# WHATSAPP_ACCESS_TOKEN=       # temporary or System User token
# WHATSAPP_VERIFY_TOKEN=       # any string you choose for webhook verification
# WHATSAPP_APP_SECRET=         # from App Settings > Basic > App Secret

# AI provider (Anthropic SDK - Etapa 1+)
ANTHROPIC_API_KEY=
# Optional: model selection for different tasks
# AGENT_LLM_PRIMARY=claude-sonnet-4-6        (default: conversation, vision)
# AGENT_LLM_FAST=claude-haiku-4-5-20251001    (default: intent classification, extraction)
# AGENT_LLM_REASONING=claude-opus-4-7         (default: complex reasoning, edge cases)
# Optional tuning
# ANTHROPIC_REQUEST_TIMEOUT_MS=15000

# OpenAI (Whisper) — optional, enables audio transcription in WhatsApp
# OPENAI_API_KEY=sk-...

# Supabase Storage — optional, enables WhatsApp file uploads to freight documents
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# Sentry error reporting (optional)
SENTRY_DSN=

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# LangSmith tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=tolvink-api
# LANGSMITH_WORKSPACE_ID=

# BPS (Banco de Previsión Social) — consultas automáticas
# BPS_ENABLED=true
# BPS_ENCRYPTION_KEY=            # openssl rand -base64 32 — cifra credenciales BPS en reposo
# BPS_BASE_URL=https://serviciosenlinea.bps.gub.uy
# BPS_RATE_LIMIT_MS=1200         # mínimo entre requests salientes a BPS
# BPS_SYNC_TICK_MS=3600000       # frecuencia del tick de sincronización (1 h)
# Paths y marcadores del portal (recalibrables sin redeploy si BPS cambia el markup):
# BPS_VIGENCIA_PATH= BPS_LOGIN_PATH= BPS_OBSERVACIONES_PATH= BPS_OBLIGACIONES_PATH= BPS_NOMINA_PATH=
# BPS_LOGIN_USER_FIELD= BPS_LOGIN_PASS_FIELD= BPS_VIGENCIA_RUT_FIELD=
# BPS_LOGIN_OK_MARKER= BPS_LOGIN_FAIL_MARKER=
