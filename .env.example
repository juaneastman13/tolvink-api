# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tolvink

# JWT
JWT_SECRET=change-this-to-64-random-chars-in-production
JWT_EXPIRES_IN=24h

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,https://tolvink.vercel.app

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# WhatsApp via Twilio (optional)
# TWILIO_ACCOUNT_SID=          # from twilio.com/console
# TWILIO_AUTH_TOKEN=            # from twilio.com/console
# TWILIO_WHATSAPP_NUMBER=+14155238886  # sandbox number or your verified number
