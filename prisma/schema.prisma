// =====================================================================
// TOLVINK — Prisma Schema v4 FINAL (Production)
// PostgreSQL · Multi-tenant · Freight = 1 viaje
// ALL models included: Fields, Trucks, PlantAccess, Chat, Tracking, User v2
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================== ENUMS ======================================

enum CompanyType {
  producer
  plant
  transporter
}

enum UserRole {
  admin
  operator
  platform_admin
}

enum FreightStatus {
  draft
  pending_assignment
  assigned
  accepted
  in_progress
  loaded
  finished
  canceled
}

enum AssignmentStatus {
  active
  accepted
  rejected
  canceled
}

enum TripStatus {
  pending
  accepted
  in_progress
  loaded
  finished
  canceled
}

enum GrainType {
  Soja
  Maiz
  Trigo
  Girasol
  Sorgo
  Cebada
  Otros
}

enum NotificationType {
  freight_created
  freight_assigned
  freight_accepted
  freight_rejected
  freight_started
  freight_loaded
  freight_confirmed
  freight_finished
  freight_canceled
  freight_updated
  message_received
  conversation_started
}

enum DocumentStep {
  request
  assignment
  load_confirmation
  delivery_confirmation
  cancellation
}

enum GranteeType {
  PRODUCER
  TRANSPORTER
}

enum AccessLevel {
  NONE
  READONLY
  OPERATOR
}

// ======================== COMPANIES ==================================

model Company {
  id               String      @id @default(uuid())
  name             String      @db.VarChar(255)
  type             CompanyType // @deprecated — usar types[] en su lugar. Mantenido para backward compat.
  types            Json        @default("[]") @map("company_types") // Fuente de verdad para tipo(s) de empresa
  address          String?
  phone            String?     @db.VarChar(50)
  email            String?     @db.VarChar(255)
  rut              String?     @db.VarChar(20)
  active           Boolean     @default(true)
  hasInternalFleet Boolean     @default(false) @map("has_internal_fleet")
  lat              Decimal?    @db.Decimal(10, 6)
  lng              Decimal?    @db.Decimal(10, 6)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  users                  User[]
  activeUsers            User[]                @relation("UserActiveCompany")
  memberships            UserCompany[]
  branches               Branch[]
  fields                 Field[]
  lots                   Lot[]
  pois                   Poi[]
  plants                 Plant[]
  trucks                 Truck[]
  freightsAsOrigin       Freight[]             @relation("FreightOriginCompany")
  freightsAsDest         Freight[]             @relation("FreightDestCompany")
  assignments            FreightAssignment[]   @relation("AssignmentTransporter")
  notifications          Notification[]
  plantAccessGiven       PlantProducerAccess[] @relation("PlantAccessGiven")
  producerAccessReceived PlantProducerAccess[] @relation("ProducerAccessReceived")
  accessGranted          CompanyAccess[]       @relation("accessGranted")
  accessReceived         CompanyAccess[]       @relation("accessReceived")
  ownedFields            Field[]               @relation("ownedFields")
  ownedTrucks            Truck[]               @relation("ownedTrucks")
  producerFreights       Freight[]             @relation("producerFreights")
  sharedLinksCreated     SharedLink[]          @relation("SharedLinkCreator")
  sharedLinksReceived    SharedLink[]          @relation("SharedLinkTarget")

  @@map("companies")
}

// ======================== USERS ======================================

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique @db.VarChar(255)
  passwordHash          String?   @map("password_hash") @db.VarChar(255)
  name                  String    @db.VarChar(255)
  role                  UserRole  @default(operator)
  companyId             String?   @map("company_id")
  phone                 String?   @unique @db.VarChar(50)
  userTypes             Json      @default("[]") @map("user_types")
  companyByType         Json      @default("{}") @map("company_by_type") // TODO: type as Record<CompanyType, string> — currently untyped Json
  roleByType            Json      @default("{}") @map("role_by_type") // TODO: type as Record<CompanyType, UserRole>
  isSuperAdmin          Boolean   @default(false) @map("is_super_admin")
  active                Boolean   @default(true)
  lastLogin             DateTime? @map("last_login")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  activeCompanyId String? @map("active_company_id")

  company                    Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activeCompany              Company?                  @relation("UserActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  memberships                UserCompany[]
  freightsRequested          Freight[]                 @relation("FreightRequestedBy")
  assignmentsMade            FreightAssignment[]       @relation("AssignmentAssignedBy")
  assignmentsAsDriver        FreightAssignment[]       @relation("AssignmentDriver")
  trucksAssigned             Truck[]                   @relation("TruckAssignedUser")
  messagesSent               Message[]
  auditLogs                  AuditLog[]
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  refreshTokens              RefreshToken[]
  producerAccess             PlantProducerAccess[]     @relation("ProducerAccessUser")
  whatsappSessions           WhatsAppSession[]
  passwordResetCodes         PasswordResetCode[]
  requestedChanges           FreightPendingChange[]    @relation("PendingChangeRequester")
  resolvedChanges            FreightPendingChange[]    @relation("PendingChangeResolver")
  uploadedDocuments          FreightDocument[]         @relation("uploadedDocuments")
  weighTicketsRegistered     WeighTicket[]             @relation("WeighTicketRegisteredBy")
  conversationParticipations ConversationParticipant[] @relation("conversationParticipations")
  sharedPoisSent             SharedPoi[]               @relation("SharedPoiSharedBy")
  sharedPoisReceived         SharedPoi[]               @relation("SharedPoiSharedWith")
  sharedFieldsSent           SharedField[]             @relation("SharedFieldSharedBy")
  sharedFieldsReceived       SharedField[]             @relation("SharedFieldSharedWith")
  sharedLotsSent             SharedLot[]               @relation("SharedLotSharedBy")
  sharedLotsReceived         SharedLot[]               @relation("SharedLotSharedWith")
  sharedLinksCreated         SharedLink[]              @relation("SharedLinkCreatedByUser")

  @@index([companyId])
  @@index([activeCompanyId])
  @@index([phone])
  @@map("users")
}

// ======================== BRANCHES (Sucursales) ======================

model Branch {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  address   String?  @db.VarChar(500)
  reference String?  @db.VarChar(500)
  lat       Decimal? @db.Decimal(10, 6)
  lng       Decimal? @db.Decimal(10, 6)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("branches")
}

// ======================== FIELDS =====================================

model Field {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  address   String?
  lat       Decimal? @db.Decimal(10, 6)
  lng       Decimal? @db.Decimal(10, 6)
  hectares  Decimal? @db.Decimal(10, 2)
  comments  String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerCompanyId String?   @map("owner_company_id")

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerCompany Company?      @relation("ownedFields", fields: [ownerCompanyId], references: [id])
  lots         Lot[]
  freights     Freight[]
  shares       SharedField[]

  @@index([companyId])
  @@index([companyId, ownerCompanyId])
  @@map("fields")
}

model SharedField {
  id               String   @id @default(uuid())
  fieldId          String   @map("field_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  field      Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  sharedBy   User  @relation("SharedFieldSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User  @relation("SharedFieldSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([fieldId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([fieldId])
  @@map("shared_fields")
}

// ======================== LOTS =======================================

model Lot {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  fieldId   String?  @map("field_id")
  hectares  Decimal? @db.Decimal(10, 2)
  lat       Decimal? @db.Decimal(10, 6)
  lng       Decimal? @db.Decimal(10, 6)
  comments  String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  field    Field?      @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  freights Freight[]   @relation("FreightOriginLot")
  shares   SharedLot[]

  @@index([companyId])
  @@index([fieldId])
  @@map("lots")
}

model SharedLot {
  id               String   @id @default(uuid())
  lotId            String   @map("lot_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  lot        Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  sharedBy   User @relation("SharedLotSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User @relation("SharedLotSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([lotId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([lotId])
  @@map("shared_lots")
}

// ======================== POINTS OF INTEREST =========================

model Poi {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  companyId       String   @map("company_id")
  address         String?
  lat             Decimal  @db.Decimal(10, 6)
  lng             Decimal  @db.Decimal(10, 6)
  comments        String?  @db.Text
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shares    SharedPoi[]

  @@index([companyId])
  @@map("pois")
}

model SharedPoi {
  id               String   @id @default(uuid())
  poiId            String   @map("poi_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  poi            Poi  @relation(fields: [poiId], references: [id], onDelete: Cascade)
  sharedBy       User @relation("SharedPoiSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith     User @relation("SharedPoiSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([poiId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([poiId])
  @@map("shared_pois")
}

// ======================== PLANTS =====================================

model Plant {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  address   String?
  lat       Decimal  @db.Decimal(10, 6)
  lng       Decimal  @db.Decimal(10, 6)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freights Freight[] @relation("FreightDestPlant")

  @@index([companyId])
  @@map("plants")
}

// ======================== TRUCKS =====================================

model Truck {
  id             String   @id @default(uuid())
  plate          String   @unique @db.VarChar(20)
  brand          String?  @db.VarChar(100)
  model          String?  @db.VarChar(100)
  capacity       String?  @db.VarChar(50)
  companyId      String   @map("company_id")
  assignedUserId String?  @map("assigned_user_id")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ownerCompanyId String?  @map("owner_company_id")

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerCompany Company?            @relation("ownedTrucks", fields: [ownerCompanyId], references: [id])
  assignedUser User?               @relation("TruckAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignments  FreightAssignment[]

  @@index([companyId])
  @@index([companyId, ownerCompanyId])
  @@index([assignedUserId])
  @@map("trucks")
}

// ======================== PLANT-PRODUCER ACCESS ======================

model PlantProducerAccess {
  id                String   @id @default(uuid())
  plantCompanyId    String   @map("plant_company_id")
  producerCompanyId String   @map("producer_company_id")
  producerUserId    String?  @map("producer_user_id")
  allowedPlantIds   Json     @default("[]") @map("allowed_plant_ids")
  allowedBranchIds  Json     @default("[]") @map("allowed_branch_ids")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  plantCompany    Company @relation("PlantAccessGiven", fields: [plantCompanyId], references: [id], onDelete: Cascade)
  producerCompany Company @relation("ProducerAccessReceived", fields: [producerCompanyId], references: [id], onDelete: Cascade)
  producerUser    User?   @relation("ProducerAccessUser", fields: [producerUserId], references: [id], onDelete: SetNull)

  @@unique([plantCompanyId, producerCompanyId, producerUserId])
  @@index([plantCompanyId])
  @@index([producerCompanyId])
  @@index([producerUserId])
  @@map("plant_producer_access")
}

// ======================== COMPANY ACCESS (Plant-Centric) ==============

model CompanyAccess {
  id               String      @id @default(uuid())
  grantorCompanyId String      @map("grantor_company_id")
  granteeCompanyId String      @map("grantee_company_id")
  granteeType      GranteeType
  accessLevel      AccessLevel @default(OPERATOR)
  permissions      Json?
  invitedBy        String?     @map("invited_by")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  grantorCompany Company @relation("accessGranted", fields: [grantorCompanyId], references: [id])
  granteeCompany Company @relation("accessReceived", fields: [granteeCompanyId], references: [id])

  @@unique([grantorCompanyId, granteeCompanyId])
  @@index([granteeCompanyId, granteeType])
  @@map("company_access")
}

// ======================== FREIGHTS ===================================

model Freight {
  id     String        @id @default(uuid())
  code   String        @unique @db.VarChar(20)
  status FreightStatus @default(draft)

  // Origin
  originCompanyId String   @map("origin_company_id")
  originLotId     String?  @map("origin_lot_id")
  fieldId         String?  @map("field_id")
  originName      String   @db.VarChar(255)
  originLat       Decimal? @db.Decimal(10, 6)
  originLng       Decimal? @db.Decimal(10, 6)

  // Destination
  destCompanyId String?  @map("dest_company_id")
  destPlantId   String?  @map("dest_plant_id")
  destName      String   @db.VarChar(255)
  destLat       Decimal? @db.Decimal(10, 6)
  destLng       Decimal? @db.Decimal(10, 6)

  // Schedule
  loadDate    DateTime  @map("load_date") @db.Date
  loadTime    String    @map("load_time") @db.VarChar(5)
  scheduledAt DateTime? @map("scheduled_at")

  // Audit
  requestedById String  @map("requested_by_id")
  notes         String?
  cancelReason  String? @map("cancel_reason") @db.VarChar(255)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  loadedAt   DateTime? @map("loaded_at")

  // Multi-truck support (v6.0)
  truckCount         Int     @default(1) @map("truck_count")
  assignedTruckCount Int     @default(0) @map("assigned_truck_count")
  isMultiTruck       Boolean @default(false) @map("is_multi_truck")

  // Producer company (when plant creates freight on behalf of a producer)
  producerCompanyId String? @map("producer_company_id")

  // Own fleet decision (per-freight, set at creation)
  // true = producer chose own fleet, false = delegated to plant, null = N/A or legacy
  useOwnFleet Boolean? @map("use_own_fleet")

  // Materialized participant company IDs for fast multi-tenant filtering
  // Contains: originCompanyId, destCompanyId, and all active assignment transportCompanyIds
  participantCompanyIds String[] @default([]) @map("participant_company_ids")

  // Public tracking share token (generated on first share request)
  shareToken          String?   @unique @map("share_token") @db.VarChar(36)
  shareTokenExpiresAt DateTime? @map("share_token_expires_at")

  // Cross-confirmations
  transporterLoadedConfirmedAt   DateTime? @map("transporter_loaded_confirmed_at")
  producerLoadedConfirmedAt      DateTime? @map("producer_loaded_confirmed_at")
  transporterFinishedConfirmedAt DateTime? @map("transporter_finished_confirmed_at")
  plantFinishedConfirmedAt       DateTime? @map("plant_finished_confirmed_at")

  // Relations
  originCompany   Company  @relation("FreightOriginCompany", fields: [originCompanyId], references: [id])
  destCompany     Company? @relation("FreightDestCompany", fields: [destCompanyId], references: [id])
  producerCompany Company? @relation("producerFreights", fields: [producerCompanyId], references: [id])
  originLot     Lot?     @relation("FreightOriginLot", fields: [originLotId], references: [id], onDelete: SetNull)
  destPlant     Plant?   @relation("FreightDestPlant", fields: [destPlantId], references: [id], onDelete: SetNull)
  field         Field?   @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  requestedBy   User     @relation("FreightRequestedBy", fields: [requestedById], references: [id])

  items          FreightItem[]
  assignments    FreightAssignment[]
  documents      FreightDocument[]
  weighTickets   WeighTicket[]
  conversation   Conversation?          @relation("FreightConversation")
  auditLogs      AuditLog[]
  trackingPoints FreightTracking[]
  liveLocations  LiveLocation[]
  pendingChanges FreightPendingChange[]
  sharedLinks    SharedLink[]

  @@index([loadDate])
  @@index([fieldId])
  @@index([requestedById])
  @@index([originCompanyId])
  @@index([destCompanyId])
  @@index([status, originCompanyId])
  @@index([status, destCompanyId])
  @@index([status, loadDate])
  @@index([scheduledAt])
  @@index([destName, originName, createdAt])
  @@index([originLotId])
  @@index([originCompanyId, status, loadDate])
  @@index([destCompanyId, status, loadDate])
  @@index([participantCompanyIds], type: Gin)
  @@map("freights")
}

// ======================== FREIGHT ITEMS ==============================

model FreightItem {
  id        String   @id @default(uuid())
  freightId String   @map("freight_id")
  grain     String   @db.VarChar(50)
  tons      Decimal  @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  freight Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)

  @@index([freightId])
  @@map("freight_items")
}

// ======================== FREIGHT ASSIGNMENTS =========================

model FreightAssignment {
  id                 String           @id @default(uuid())
  freightId          String           @map("freight_id")
  transportCompanyId String           @map("transport_company_id")
  status             AssignmentStatus @default(active)

  driverId   String? @map("driver_id")
  driverName String? @map("driver_name") @db.VarChar(255)
  plate      String? @db.VarChar(20)
  truckId    String? @map("truck_id")

  assignedById  String  @map("assigned_by_id")
  reason        String? @db.VarChar(255)
  queuePosition Int     @default(0) @map("queue_position")

  // Multi-truck trip lifecycle (v6.0)
  tripStatus                     TripStatus @default(pending) @map("trip_status")
  tripNumber                     Int        @default(1) @map("trip_number")
  tons                           Decimal?   @db.Decimal(10, 2)
  loadedTons                     Decimal?   @map("loaded_tons") @db.Decimal(10, 2)
  startedAt                      DateTime?  @map("trip_started_at")
  loadedAt                       DateTime?  @map("trip_loaded_at")
  finishedAt                     DateTime?  @map("trip_finished_at")
  transporterLoadedConfirmedAt   DateTime?  @map("trip_transporter_loaded_confirmed_at")
  producerLoadedConfirmedAt      DateTime?  @map("trip_producer_loaded_confirmed_at")
  transporterFinishedConfirmedAt DateTime?  @map("trip_transporter_finished_confirmed_at")
  plantFinishedConfirmedAt       DateTime?  @map("trip_plant_finished_confirmed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  freight          Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)
  transportCompany Company @relation("AssignmentTransporter", fields: [transportCompanyId], references: [id])
  assignedBy       User    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  driver           User?   @relation("AssignmentDriver", fields: [driverId], references: [id])
  truck            Truck?  @relation(fields: [truckId], references: [id], onDelete: SetNull)
  weighTickets     WeighTicket[]

  @@index([freightId])
  @@index([freightId, tripStatus])
  @@index([transportCompanyId])
  @@index([transportCompanyId, status])
  @@index([truckId])
  @@index([driverId])
  @@index([driverId, status])
  @@map("freight_assignments")
}

// ======================== FREIGHT DOCUMENTS ===========================

model FreightDocument {
  id           String        @id @default(uuid())
  freightId    String        @map("freight_id")
  name         String        @db.VarChar(255)
  url          String        @db.VarChar(500)
  type         String        @db.VarChar(50)
  step         DocumentStep?
  uploadedById String        @map("uploaded_by_id")
  ocrData      Json?         @map("ocr_data")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  freight    Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("uploadedDocuments", fields: [uploadedById], references: [id])

  @@index([freightId])
  @@index([freightId, step])
  @@index([uploadedById])
  @@map("freight_documents")
}

// ======================== WEIGH TICKETS ===============================

model WeighTicket {
  id             String   @id @default(uuid())
  freightId      String   @map("freight_id")
  assignmentId   String?  @map("assignment_id")
  type           String   @default("destination") @db.VarChar(20) // "origin" | "destination"
  ticketNumber   String?  @map("ticket_number") @db.VarChar(100)
  grossWeight    Decimal? @map("gross_weight") @db.Decimal(10, 2)
  tareWeight     Decimal? @map("tare_weight") @db.Decimal(10, 2)
  netWeight      Decimal? @map("net_weight") @db.Decimal(10, 2)
  humidity       Decimal? @db.Decimal(5, 2)
  impurities     Decimal? @db.Decimal(5, 2)
  dockage        Decimal? @db.Decimal(10, 2)
  temperature    Decimal? @db.Decimal(5, 2)
  observations   String?  @db.Text
  photoUrl       String?  @map("photo_url") @db.VarChar(500)
  ocrData        Json?    @map("ocr_data")
  ocrConfidence  Decimal? @map("ocr_confidence") @db.Decimal(3, 2)
  registeredById String   @map("registered_by_id")
  registeredAt   DateTime @default(now()) @map("registered_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  freight      Freight            @relation(fields: [freightId], references: [id], onDelete: Cascade)
  assignment   FreightAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  registeredBy User               @relation("WeighTicketRegisteredBy", fields: [registeredById], references: [id])

  @@index([freightId])
  @@index([assignmentId])
  @@index([ticketNumber])
  @@index([freightId, assignmentId, type])
  @@map("weigh_tickets")
}

// ======================== FREIGHT TRACKING ============================

model FreightTracking {
  id        String   @id @default(uuid())
  freightId String   @map("freight_id")
  userId    String?  @map("user_id")
  lat       Decimal  @db.Decimal(10, 6)
  lng       Decimal  @db.Decimal(10, 6)
  speed     Decimal? @db.Decimal(6, 2)
  heading   Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  freight Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)

  @@index([freightId])
  @@index([createdAt])
  @@index([freightId, createdAt])
  @@index([freightId, userId, createdAt])
  @@map("freight_tracking")
}

// ======================== LIVE LOCATION (real-time sharing) ============

model LiveLocation {
  id        String   @id @default(uuid())
  freightId String   @map("freight_id")
  userId    String   @map("user_id")
  userName  String   @map("user_name") @db.VarChar(255)
  userRole  String   @map("user_role") @db.VarChar(30)
  lat       Decimal  @db.Decimal(10, 6)
  lng       Decimal  @db.Decimal(10, 6)
  speed     Decimal? @db.Decimal(6, 2)
  heading   Decimal? @db.Decimal(5, 2)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  freight Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)

  @@unique([freightId, userId])
  @@index([freightId, active])
  @@map("live_locations")
}

// ======================== CONVERSATIONS ===============================

model Conversation {
  id        String   @id @default(uuid())
  freightId String?  @unique @map("freight_id")
  createdAt DateTime @default(now()) @map("created_at")

  freight      Freight?                  @relation("FreightConversation", fields: [freightId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]

  @@map("conversations")
}

// ======================== CONVERSATION PARTICIPANTS ===================

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  companyId      String    @map("company_id")
  userId         String?   @map("user_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")
  pinnedAt       DateTime? @map("pinned_at")
  markedUnread   Boolean   @default(false) @map("marked_unread")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation("conversationParticipations", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([conversationId, companyId])
  @@index([companyId])
  @@index([conversationId, userId])
  @@map("conversation_participants")
}

// ======================== MESSAGES ====================================

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  text           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([senderId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ======================== AUDIT LOGS =================================

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") @db.VarChar(30)
  entityId   String   @map("entity_id")
  action     String   @db.VarChar(50)
  fromValue  String?  @map("from_value") @db.Text
  toValue    String?  @map("to_value") @db.Text
  userId     String   @map("user_id")
  freightId  String?  @map("freight_id")
  reason     String?  @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  freight Freight? @relation(fields: [freightId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([freightId])
  @@index([freightId, createdAt])
  @@map("audit_logs")
}

// ======================== NOTIFICATIONS ===============================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  companyId String?          @map("company_id")
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String?          @db.VarChar(500)
  entityId  String?          @map("entity_id")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, read, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ======================== PUSH SUBSCRIPTIONS ===========================

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ======================== USER-COMPANY MEMBERSHIPS ===================

model UserCompany {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  role      String   @default("operario") @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([userId, active])
  @@map("user_companies")
}

// ======================== REFRESH TOKENS ==============================

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ======================== ANALYTICS ==================================
model AnalyticsEvent {
  id        String   @id @default(uuid())
  event     String   @db.VarChar(100)
  data      Json     @default("{}") // Prisma handles this correctly for PostgreSQL
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@index([event, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

// ======================== WHATSAPP =====================================

model WhatsAppSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  phone     String    @db.VarChar(50)
  flowType  String?   @map("flow_type") @db.VarChar(50)
  flowState Json?     @map("flow_state")
  flowStep  String?   @map("flow_step") @db.VarChar(50)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([phone, expiresAt])
  @@index([userId])
  @@index([userId, expiresAt])
  @@map("whatsapp_sessions")
}

model WhatsAppMessageLog {
  id          String   @id @default(uuid())
  waMessageId String?  @map("wa_message_id") @db.VarChar(100)
  phone       String   @db.VarChar(50)
  direction   String   @db.VarChar(10)
  type        String   @db.VarChar(30)
  content     Json?
  status      String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@index([waMessageId])
  @@index([createdAt])
  @@map("whatsapp_message_logs")
}

// ======================== PASSWORD RESET CODES ========================

model PasswordResetCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  resetJti  String?  @map("reset_jti")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

// ======================== FREIGHT PENDING CHANGES =======================

model FreightPendingChange {
  id                String    @id @default(uuid())
  freightId         String    @map("freight_id")
  changeType        String    @db.VarChar(50)
  fromValue         Json
  toValue           Json
  requestedById     String    @map("requested_by_id")
  approverCompanyId String    @map("approver_company_id")
  status            String    @default("pending") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at")
  resolvedAt        DateTime? @map("resolved_at")
  resolvedById      String?   @map("resolved_by_id")

  freight     Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("PendingChangeRequester", fields: [requestedById], references: [id])
  resolvedBy  User?   @relation("PendingChangeResolver", fields: [resolvedById], references: [id])

  @@index([freightId, status])
  @@index([approverCompanyId, status])
  @@map("freight_pending_changes")
}

// ======================== SHARED LINKS ================================

enum SharedLinkType {
  FREIGHT
  PORTAL
  TICKET
}

enum LinkCreationChannel {
  WEB
  WHATSAPP
}

model SharedLink {
  id               String              @id @default(uuid())
  token            String              @unique
  linkType         SharedLinkType      @map("link_type")
  creatorCompanyId String              @map("creator_company_id")
  targetCompanyId  String              @map("target_company_id")
  freightId        String?             @map("freight_id")
  ticketId         String?             @map("ticket_id")
  createdById      String?             @map("created_by_id")
  createdVia       LinkCreationChannel @default(WEB) @map("created_via")
  expiresAt        DateTime?           @map("expires_at")
  revokedAt        DateTime?           @map("revoked_at")
  lastAccessedAt   DateTime?           @map("last_accessed_at")
  accessCount      Int                 @default(0) @map("access_count")
  createdAt        DateTime            @default(now()) @map("created_at")

  creatorCompany Company  @relation("SharedLinkCreator", fields: [creatorCompanyId], references: [id])
  targetCompany  Company  @relation("SharedLinkTarget", fields: [targetCompanyId], references: [id])
  freight        Freight? @relation(fields: [freightId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation("SharedLinkCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([creatorCompanyId, linkType])
  @@index([targetCompanyId, linkType])
  @@index([freightId])
  @@map("shared_links")
}
