// =====================================================================
// TOLVINK — Prisma Schema v4 FINAL (Production)
// PostgreSQL · Multi-tenant · Freight = 1 viaje
// ALL models included: Fields, Trucks, PlantAccess, Chat, Tracking, User v2
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================== ENUMS ======================================

enum CompanyType {
  producer
  plant
  transporter
}

enum UserRole {
  admin
  operator
  platform_admin
}

enum FreightStatus {
  draft
  pending_assignment
  assigned
  accepted
  in_progress
  loaded
  finished
  canceled
}

enum AssignmentStatus {
  active
  accepted
  rejected
  canceled
}

enum TripStatus {
  pending
  accepted
  in_progress
  loaded
  finished
  canceled
}

enum GrainType {
  Soja
  Maiz
  Trigo
  Girasol
  Sorgo
  Cebada
  Otros
}

enum NotificationType {
  freight_created
  freight_assigned
  freight_accepted
  freight_rejected
  freight_started
  freight_loaded
  freight_confirmed
  freight_finished
  freight_canceled
  freight_updated
  message_received
  conversation_started
}

enum DocumentStep {
  request
  assignment
  load_confirmation
  delivery_confirmation
  cancellation
}

enum GranteeType {
  PRODUCER
  TRANSPORTER
}

enum AccessLevel {
  NONE
  READONLY
  OPERATOR
}

enum StockItemCategory {
  grain
  fertilizer
  seed
  agrochemical
  fuel
  other
}

enum StockUnit {
  kg
  tn
  lt
  unit
  bag
}

enum StockLocationType {
  field
  lot
  plant
  warehouse
  silo
  silo_bag
  shed
  tank
  other
}

enum StockOwnershipType {
  own
  third_party
}

enum StockMovementType {
  freight_in_internal
  freight_in_third_party
  manual_in
  purchase_in
  adjustment_in
  sale_out
  reexpedition_out
  consumption_out
  manual_out
  adjustment_out
  transfer
}

enum StockSourceType {
  freight
  manual
  adjustment
  migration
  system
}

// ======================== COMPANIES ==================================

model Company {
  id               String      @id @default(uuid())
  name             String      @db.VarChar(255)
  type             CompanyType // @deprecated — usar types[] en su lugar. Mantenido para backward compat.
  types            Json        @default("[]") @map("company_types") // Fuente de verdad para tipo(s) de empresa
  address          String?
  phone            String?     @db.VarChar(50)
  email            String?     @db.VarChar(255)
  rut              String?     @db.VarChar(20)
  active           Boolean     @default(true)
  hasInternalFleet         Boolean     @default(false) @map("has_internal_fleet")
  autonomousDriverEnabled  Boolean     @default(false) @map("autonomous_driver_enabled")
  enabledModules   String[]    @default(["logistics"]) @map("enabled_modules")
  lat              Decimal?    @db.Decimal(10, 6)
  lng              Decimal?    @db.Decimal(10, 6)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  users                  User[]
  activeUsers            User[]                @relation("UserActiveCompany")
  memberships            UserCompany[]
  branches               Branch[]
  fields                 Field[]
  lots                   Lot[]
  pois                   Poi[]
  plants                 Plant[]
  trucks                 Truck[]
  freightsAsOrigin       Freight[]             @relation("FreightOriginCompany")
  freightsAsDest         Freight[]             @relation("FreightDestCompany")
  assignments            FreightAssignment[]   @relation("AssignmentTransporter")
  notifications          Notification[]
  plantAccessGiven       PlantProducerAccess[] @relation("PlantAccessGiven")
  producerAccessReceived PlantProducerAccess[] @relation("ProducerAccessReceived")
  accessGranted          CompanyAccess[]       @relation("accessGranted")
  accessReceived         CompanyAccess[]       @relation("accessReceived")
  ownedFields            Field[]               @relation("ownedFields")
  ownedTrucks            Truck[]               @relation("ownedTrucks")
  producerFreights       Freight[]             @relation("producerFreights")
  sharedLinksCreated     SharedLink[]          @relation("SharedLinkCreator")
  sharedLinksReceived    SharedLink[]          @relation("SharedLinkTarget")
  truckDocuments         TruckDocument[]       @relation("TruckDocCompany")
  truckExpenses          TruckExpense[]        @relation("TruckExpCompany")
  truckIncomes           TruckIncome[]         @relation("TruckIncCompany")
  truckMovements         TruckMovement[]       @relation("TruckMovCompany")
  machines               Machine[]
  stockItems             StockItem[]
  stockLocations         StockLocation[]
  stockMovements         StockMovement[]
  stockBalances          StockBalance[]
  companyProducts        CompanyProduct[]

  @@map("companies")
}

// ======================== USERS ======================================

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique @db.VarChar(255)
  passwordHash          String?   @map("password_hash") @db.VarChar(255)
  name                  String    @db.VarChar(255)
  role                  UserRole  @default(operator)
  companyId             String?   @map("company_id")
  phone                 String?   @unique @db.VarChar(50)
  userTypes             Json      @default("[]") @map("user_types")
  companyByType         Json      @default("{}") @map("company_by_type") // TODO: type as Record<CompanyType, string> — currently untyped Json
  roleByType            Json      @default("{}") @map("role_by_type") // TODO: type as Record<CompanyType, UserRole>
  isSuperAdmin          Boolean   @default(false) @map("is_super_admin")
  active                Boolean   @default(true)
  lastLogin             DateTime? @map("last_login")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  activeCompanyId String? @map("active_company_id")

  company                    Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activeCompany              Company?                  @relation("UserActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  memberships                UserCompany[]
  freightsRequested          Freight[]                 @relation("FreightRequestedBy")
  assignmentsMade            FreightAssignment[]       @relation("AssignmentAssignedBy")
  assignmentsAsDriver        FreightAssignment[]       @relation("AssignmentDriver")
  trucksAssigned             Truck[]                   @relation("TruckAssignedUser")
  messagesSent               Message[]
  auditLogs                  AuditLog[]
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  refreshTokens              RefreshToken[]
  producerAccess             PlantProducerAccess[]     @relation("ProducerAccessUser")
  whatsappSessions           WhatsAppSession[]
  passwordResetCodes         PasswordResetCode[]
  requestedChanges           FreightPendingChange[]    @relation("PendingChangeRequester")
  resolvedChanges            FreightPendingChange[]    @relation("PendingChangeResolver")
  uploadedDocuments          FreightDocument[]         @relation("uploadedDocuments")
  weighTicketsRegistered     WeighTicket[]             @relation("WeighTicketRegisteredBy")
  conversationParticipations ConversationParticipant[] @relation("conversationParticipations")
  sharedPoisSent             SharedPoi[]               @relation("SharedPoiSharedBy")
  sharedPoisReceived         SharedPoi[]               @relation("SharedPoiSharedWith")
  sharedFieldsSent           SharedField[]             @relation("SharedFieldSharedBy")
  sharedFieldsReceived       SharedField[]             @relation("SharedFieldSharedWith")
  sharedLotsSent             SharedLot[]               @relation("SharedLotSharedBy")
  sharedLotsReceived         SharedLot[]               @relation("SharedLotSharedWith")
  sharedLinksCreated         SharedLink[]              @relation("SharedLinkCreatedByUser")
  truckDocsUploaded          TruckDocument[]           @relation("TruckDocUploader")
  truckExpensesCreated       TruckExpense[]            @relation("TruckExpCreator")
  truckIncomesCreated        TruckIncome[]             @relation("TruckIncCreator")
  truckMovementsCreated      TruckMovement[]           @relation("TruckMovCreator")
  truckMovementsAsDrv        TruckMovement[]           @relation("TruckMovDriver")
  stockMovementsCreated      StockMovement[]           @relation("StockMovementCreatedBy")
  stockMovementsReverted     StockMovement[]           @relation("StockMovementRevertedBy")
  companyProductsCreated     CompanyProduct[]          @relation("ProductCreatedBy")

  @@index([companyId])
  @@index([activeCompanyId])
  @@index([phone])
  @@map("users")
}

// ======================== BRANCHES (Sucursales) ======================

model Branch {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  address   String?  @db.VarChar(500)
  reference String?  @db.VarChar(500)
  lat       Decimal? @db.Decimal(10, 6)
  lng       Decimal? @db.Decimal(10, 6)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("branches")
}

// ======================== FIELDS =====================================

model Field {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  address   String?
  lat       Decimal? @db.Decimal(10, 6)
  lng       Decimal? @db.Decimal(10, 6)
  hectares  Decimal? @db.Decimal(10, 2)
  comments  String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerCompanyId String?   @map("owner_company_id")

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerCompany Company?      @relation("ownedFields", fields: [ownerCompanyId], references: [id])
  lots         Lot[]
  freights     Freight[]
  shares       SharedField[]
  movementsAsOrigin TruckMovement[] @relation("movementOriginField")
  movementsAsDest   TruckMovement[] @relation("movementDestField")
  stockLocations    StockLocation[]

  @@index([companyId])
  @@index([companyId, ownerCompanyId])
  @@map("fields")
}

model SharedField {
  id               String   @id @default(uuid())
  fieldId          String   @map("field_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  field      Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  sharedBy   User  @relation("SharedFieldSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User  @relation("SharedFieldSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([fieldId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([fieldId])
  @@map("shared_fields")
}

// ======================== LOTS =======================================

model Lot {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  fieldId   String?  @map("field_id")
  hectares  Decimal? @db.Decimal(10, 2)
  lat       Decimal? @db.Decimal(10, 6)
  lng       Decimal? @db.Decimal(10, 6)
  comments  String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  field    Field?      @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  freights Freight[]   @relation("FreightOriginLot")
  shares   SharedLot[]
  movementsAsOrigin TruckMovement[] @relation("movementOriginLot")
  movementsAsDest   TruckMovement[] @relation("movementDestLot")
  stockLocations    StockLocation[]

  @@index([companyId])
  @@index([fieldId])
  @@map("lots")
}

model SharedLot {
  id               String   @id @default(uuid())
  lotId            String   @map("lot_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  lot        Lot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  sharedBy   User @relation("SharedLotSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith User @relation("SharedLotSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([lotId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([lotId])
  @@map("shared_lots")
}

// ======================== POINTS OF INTEREST =========================

model Poi {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(255)
  companyId       String   @map("company_id")
  address         String?
  lat             Decimal  @db.Decimal(10, 6)
  lng             Decimal  @db.Decimal(10, 6)
  comments        String?  @db.Text
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shares    SharedPoi[]

  @@index([companyId])
  @@map("pois")
}

model SharedPoi {
  id               String   @id @default(uuid())
  poiId            String   @map("poi_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  poi            Poi  @relation(fields: [poiId], references: [id], onDelete: Cascade)
  sharedBy       User @relation("SharedPoiSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith     User @relation("SharedPoiSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([poiId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([poiId])
  @@map("shared_pois")
}

// ======================== PLANTS =====================================

model Plant {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  address   String?
  lat       Decimal  @db.Decimal(10, 6)
  lng       Decimal  @db.Decimal(10, 6)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freights Freight[] @relation("FreightDestPlant")
  stockLocations StockLocation[]

  @@index([companyId])
  @@map("plants")
}

model TolvinkPlant {
  id            String   @id @default(uuid())
  sourceRowId   Int?     @unique @map("source_row_id")
  sourcePlantId Int?     @unique @map("source_plant_id")
  name          String   @db.VarChar(255)
  altName       String?  @map("alt_name") @db.VarChar(255)
  department    String?  @db.VarChar(100)
  locality      String?  @db.VarChar(150)
  lat           Decimal? @db.Decimal(10, 6)
  lng           Decimal? @db.Decimal(10, 6)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  freights Freight[] @relation("FreightTolvinkPlant")

  @@index([name])
  @@index([department])
  @@index([locality])
  @@map("tolvink_plants")
}

// ======================== TRUCKS =====================================

model Truck {
  id             String   @id @default(uuid())
  plate          String   @unique @db.VarChar(20)
  brand          String?  @db.VarChar(100)
  model          String?  @db.VarChar(100)
  capacity       String?  @db.VarChar(50)
  companyId      String   @map("company_id")
  assignedUserId String?  @map("assigned_user_id")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ownerCompanyId String?  @map("owner_company_id")

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerCompany Company?            @relation("ownedTrucks", fields: [ownerCompanyId], references: [id])
  assignedUser User?               @relation("TruckAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  currentOdometer  Int?      @map("current_odometer")
  lastOdometerDate DateTime? @map("last_odometer_date")

  assignments  FreightAssignment[]
  documents    TruckDocument[]
  expenses     TruckExpense[]
  incomes      TruckIncome[]
  movements    TruckMovement[]

  @@index([companyId])
  @@index([companyId, ownerCompanyId])
  @@index([assignedUserId])
  @@map("trucks")
}

// ======================== TRUCK DOCUMENTS ==============================

model TruckDocument {
  id           String            @id @default(uuid())
  truckId      String            @map("truck_id")
  companyId    String            @map("company_id")
  type         TruckDocumentType
  name         String?           @db.VarChar(255)
  fileUrl      String            @map("file_url") @db.VarChar(500)
  fileName     String            @map("file_name") @db.VarChar(255)
  mimeType     String?           @map("mime_type") @db.VarChar(100)
  issuedAt     DateTime?         @map("issued_at")
  expiresAt    DateTime?         @map("expires_at")
  notes        String?           @db.Text
  uploadedById String            @map("uploaded_by_id")
  // Cross-linking: document can be associated with ONE of these (or none = general doc)
  expenseId    String?           @map("expense_id")
  incomeId     String?           @map("income_id")
  freightId    String?           @map("freight_id")
  movementId   String?           @map("movement_id")
  // OCR
  ocrData      Json?             @map("ocr_data")
  ocrStatus    String?           @map("ocr_status") @db.VarChar(20) // pending, processing, completed, failed
  ocrProcessedAt DateTime?       @map("ocr_processed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  truck      Truck          @relation(fields: [truckId], references: [id], onDelete: Cascade)
  company    Company        @relation("TruckDocCompany", fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("TruckDocUploader", fields: [uploadedById], references: [id])
  expense    TruckExpense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  income     TruckIncome?   @relation(fields: [incomeId], references: [id], onDelete: SetNull)
  freight    Freight?       @relation("TruckDocFreight", fields: [freightId], references: [id], onDelete: SetNull)
  movement   TruckMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@index([truckId, companyId])
  @@index([expiresAt])
  @@index([expenseId])
  @@index([incomeId])
  @@index([freightId])
  @@index([movementId])
  @@index([uploadedById])
  @@map("truck_documents")
}

enum TruckDocumentType {
  VTV_ITV             // ITV (kept for backward compat, label "ITV")
  INSURANCE
  TRANSPORT_LICENSE
  GREEN_CARD          // @deprecated — hidden from new doc dropdown
  DRIVER_LICENSE
  RUAT                // @deprecated — hidden from new doc dropdown
  SENASA              // @deprecated — hidden from new doc dropdown
  FUMIGATION          // @deprecated — hidden from new doc dropdown
  BPS_DGI
  GET_CERTIFICATE
  CIRCULATION_PERMIT
  OTHER
}

// ======================== TRUCK EXPENSES ================================

model TruckExpense {
  id          String           @id @default(uuid())
  truckId     String           @map("truck_id")
  companyId   String           @map("company_id")
  freightId   String?          @map("freight_id")
  type        TruckExpenseType
  description String?          @db.VarChar(500)
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("UYU") @db.VarChar(3)
  exchangeRate Decimal          @default(40) @map("exchange_rate") @db.Decimal(8, 2)
  date         DateTime
  receiptUrl   String?          @map("receipt_url") @db.VarChar(500)
  receiptName  String?          @map("receipt_name") @db.VarChar(255)
  active       Boolean          @default(true)
  createdById  String           @map("created_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  truck     Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  company   Company  @relation("TruckExpCompany", fields: [companyId], references: [id], onDelete: Cascade)
  freight   Freight? @relation(fields: [freightId], references: [id], onDelete: SetNull)
  createdBy User     @relation("TruckExpCreator", fields: [createdById], references: [id])
  documents TruckDocument[]

  @@index([truckId, companyId])
  @@index([truckId, active])
  @@index([date])
  @@index([createdById])
  @@map("truck_expenses")
}

// ======================== TRUCK INCOMES =================================

model TruckIncome {
  id            String       @id @default(uuid())
  truckId       String       @map("truck_id")
  companyId     String       @map("company_id")
  freightId     String?      @map("freight_id")
  concept       String       @db.VarChar(500)
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("UYU") @db.VarChar(3)
  exchangeRate  Decimal      @default(40) @map("exchange_rate") @db.Decimal(8, 2)
  date          DateTime
  invoiceNumber String?      @map("invoice_number") @db.VarChar(100)
  invoiceUrl    String?      @map("invoice_url") @db.VarChar(500)
  status        IncomeStatus @default(PENDING)
  notes         String?      @db.Text
  active        Boolean      @default(true)
  createdById   String       @map("created_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  truck     Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  company   Company  @relation("TruckIncCompany", fields: [companyId], references: [id], onDelete: Cascade)
  freight   Freight? @relation("TruckIncFreight", fields: [freightId], references: [id], onDelete: SetNull)
  createdBy User     @relation("TruckIncCreator", fields: [createdById], references: [id])
  documents TruckDocument[]

  @@index([truckId, companyId])
  @@index([truckId, active])
  @@index([truckId, date])
  @@index([freightId])
  @@index([createdById])
  @@map("truck_incomes")
}

enum IncomeStatus {
  PENDING
  PAID
  OVERDUE
}

// ======================== TRUCK MOVEMENTS ================================

model TruckMovement {
  id          String       @id @default(uuid())
  truckId     String       @map("truck_id")
  companyId   String       @map("company_id")
  driverId    String?      @map("driver_id")
  type        MovementType
  description   String?      @db.VarChar(500)
  originName    String?      @map("origin_name") @db.VarChar(255)
  originLat     Decimal?     @map("origin_lat") @db.Decimal(10, 6)
  originLng     Decimal?     @map("origin_lng") @db.Decimal(10, 6)
  originFieldId String?      @map("origin_field_id")
  originLotId   String?      @map("origin_lot_id")
  destName      String?      @map("dest_name") @db.VarChar(255)
  destLat       Decimal?     @map("dest_lat") @db.Decimal(10, 6)
  destLng       Decimal?     @map("dest_lng") @db.Decimal(10, 6)
  destFieldId   String?      @map("dest_field_id")
  destLotId     String?      @map("dest_lot_id")
  departureAt   DateTime?    @map("departure_at")
  arrivalAt   DateTime?    @map("arrival_at")
  kmDriven    Decimal?     @map("km_driven") @db.Decimal(10, 1)
  fuelLiters  Decimal?     @map("fuel_liters") @db.Decimal(10, 1)
  fuelCost    Decimal?     @map("fuel_cost") @db.Decimal(12, 2)
  tollCost    Decimal?     @map("toll_cost") @db.Decimal(12, 2)
  notes       String?      @db.Text
  active      Boolean      @default(true)
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  truck       Truck   @relation(fields: [truckId], references: [id], onDelete: Cascade)
  company     Company @relation("TruckMovCompany", fields: [companyId], references: [id], onDelete: Cascade)
  driver      User?   @relation("TruckMovDriver", fields: [driverId], references: [id], onDelete: SetNull)
  createdBy   User    @relation("TruckMovCreator", fields: [createdById], references: [id])
  originField Field?  @relation("movementOriginField", fields: [originFieldId], references: [id])
  originLot   Lot?    @relation("movementOriginLot", fields: [originLotId], references: [id])
  destField   Field?  @relation("movementDestField", fields: [destFieldId], references: [id])
  destLot     Lot?    @relation("movementDestLot", fields: [destLotId], references: [id])
  documents   TruckDocument[]

  @@index([truckId, companyId])
  @@index([truckId, active])
  @@index([truckId, departureAt])
  @@index([createdById])
  @@index([driverId])
  @@map("truck_movements")
}

enum MovementType {
  REPOSITIONING
  MAINTENANCE_TRIP
  INTERNAL_TRANSFER
  PERSONAL
  OTHER
}

enum TruckExpenseType {
  FUEL
  TOLL
  MAINTENANCE
  TIRE
  INSURANCE
  FINE
  PARKING
  MEAL
  OTHER
}

// ======================== PLANT-PRODUCER ACCESS ======================

model PlantProducerAccess {
  id                String   @id @default(uuid())
  plantCompanyId    String   @map("plant_company_id")
  producerCompanyId String   @map("producer_company_id")
  producerUserId    String?  @map("producer_user_id")
  allowedPlantIds   Json     @default("[]") @map("allowed_plant_ids")
  allowedBranchIds  Json     @default("[]") @map("allowed_branch_ids")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  plantCompany    Company @relation("PlantAccessGiven", fields: [plantCompanyId], references: [id], onDelete: Cascade)
  producerCompany Company @relation("ProducerAccessReceived", fields: [producerCompanyId], references: [id], onDelete: Cascade)
  producerUser    User?   @relation("ProducerAccessUser", fields: [producerUserId], references: [id], onDelete: SetNull)

  @@unique([plantCompanyId, producerCompanyId, producerUserId])
  @@index([plantCompanyId])
  @@index([producerCompanyId])
  @@index([producerUserId])
  @@map("plant_producer_access")
}

// ======================== COMPANY ACCESS (Plant-Centric) ==============

model CompanyAccess {
  id               String      @id @default(uuid())
  grantorCompanyId String      @map("grantor_company_id")
  granteeCompanyId String      @map("grantee_company_id")
  granteeType      GranteeType
  accessLevel      AccessLevel @default(OPERATOR)
  permissions      Json?
  invitedBy        String?     @map("invited_by")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  grantorCompany Company @relation("accessGranted", fields: [grantorCompanyId], references: [id], onDelete: Cascade)
  granteeCompany Company @relation("accessReceived", fields: [granteeCompanyId], references: [id], onDelete: Cascade)

  @@unique([grantorCompanyId, granteeCompanyId])
  @@index([granteeCompanyId, granteeType])
  @@map("company_access")
}

// ======================== FREIGHTS ===================================

model Freight {
  id     String        @id @default(uuid())
  code   String        @unique @db.VarChar(20)
  status FreightStatus @default(draft)

  // Origin
  originCompanyId String   @map("origin_company_id")
  originLotId     String?  @map("origin_lot_id")
  fieldId         String?  @map("field_id")
  originName      String   @db.VarChar(255)
  originLat       Decimal? @db.Decimal(10, 6)
  originLng       Decimal? @db.Decimal(10, 6)

  // Destination
  destCompanyId   String?  @map("dest_company_id")
  destPlantId     String?  @map("dest_plant_id")
  tolvinkPlantId  String?  @map("tolvink_plant_id")
  destName        String   @db.VarChar(255)
  destLat         Decimal? @db.Decimal(10, 6)
  destLng         Decimal? @db.Decimal(10, 6)

  // Schedule
  loadDate    DateTime  @map("load_date") @db.Date
  loadTime    String    @map("load_time") @db.VarChar(5)
  scheduledAt DateTime? @map("scheduled_at")

  // Audit
  requestedById String  @map("requested_by_id")
  notes         String?
  cancelReason  String? @map("cancel_reason") @db.VarChar(255)

  // Pre-calculated route (Google Directions, one-time on creation)
  routePolyline     String?   @map("route_polyline") @db.Text
  routeDistanceKm   Float?    @map("route_distance_km")
  routeDurationMin   Int?     @map("route_duration_min")
  routeCalculatedAt DateTime? @map("route_calculated_at")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at") @default(now())
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  loadedAt   DateTime? @map("loaded_at")

  // Multi-truck support (v6.0)
  truckCount         Int     @default(1) @map("truck_count")
  assignedTruckCount Int     @default(0) @map("assigned_truck_count")
  isMultiTruck       Boolean @default(false) @map("is_multi_truck")

  // Producer company (when plant creates freight on behalf of a producer)
  producerCompanyId String? @map("producer_company_id")

  // Own fleet decision (per-freight, set at creation)
  // true = producer chose own fleet, false = delegated to plant, null = N/A or legacy
  useOwnFleet Boolean? @map("use_own_fleet")

  // Autonomous driver freight
  isAutonomous        Boolean   @default(false) @map("is_autonomous")
  originFreeText      String?   @map("origin_free_text")
  destinationFreeText String?   @map("destination_free_text")
  arrivedAtPlantAt    DateTime? @map("arrived_at_plant_at")

  // Materialized participant company IDs for fast multi-tenant filtering
  // Contains: originCompanyId, destCompanyId, and all active assignment transportCompanyIds
  participantCompanyIds String[] @default([]) @map("participant_company_ids")

  // Public tracking share token (generated on first share request)
  shareToken          String?   @unique @map("share_token") @db.VarChar(36)
  shareTokenExpiresAt DateTime? @map("share_token_expires_at")

  // Cross-confirmations
  transporterLoadedConfirmedAt   DateTime? @map("transporter_loaded_confirmed_at")
  producerLoadedConfirmedAt      DateTime? @map("producer_loaded_confirmed_at")
  transporterFinishedConfirmedAt DateTime? @map("transporter_finished_confirmed_at")
  plantFinishedConfirmedAt       DateTime? @map("plant_finished_confirmed_at")

  // Producer → Plant approval
  needsPlantApproval             Boolean   @default(false) @map("needs_plant_approval")
  plantApprovedAt                DateTime? @map("plant_approved_at")

  // Relations
  originCompany   Company  @relation("FreightOriginCompany", fields: [originCompanyId], references: [id], onDelete: Restrict)
  destCompany     Company? @relation("FreightDestCompany", fields: [destCompanyId], references: [id], onDelete: SetNull)
  producerCompany Company? @relation("producerFreights", fields: [producerCompanyId], references: [id], onDelete: SetNull)
  originLot       Lot?          @relation("FreightOriginLot", fields: [originLotId], references: [id], onDelete: SetNull)
  destPlant       Plant?        @relation("FreightDestPlant", fields: [destPlantId], references: [id], onDelete: SetNull)
  tolvinkPlant    TolvinkPlant? @relation("FreightTolvinkPlant", fields: [tolvinkPlantId], references: [id], onDelete: SetNull)
  field           Field?        @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  requestedBy     User          @relation("FreightRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  items          FreightItem[]
  assignments    FreightAssignment[]
  documents      FreightDocument[]
  weighTickets   WeighTicket[]
  conversation   Conversation?          @relation("FreightConversation")
  auditLogs      AuditLog[]
  trackingPoints FreightTracking[]
  liveLocations  LiveLocation[]
  pendingChanges FreightPendingChange[]
  sharedLinks    SharedLink[]
  truckExpenses  TruckExpense[]
  truckIncomes   TruckIncome[]    @relation("TruckIncFreight")
  truckDocs      TruckDocument[]  @relation("TruckDocFreight")
  stockMovements StockMovement[]

  @@index([loadDate])
  @@index([fieldId])
  @@index([requestedById])
  @@index([originCompanyId])
  @@index([destCompanyId])
  @@index([destPlantId])
  @@index([tolvinkPlantId])
  @@index([status, originCompanyId])
  @@index([status, destCompanyId])
  @@index([status, destCompanyId, createdAt])
  @@index([status, loadDate])
  @@index([scheduledAt])
  @@index([destName, originName, createdAt])
  @@index([originLotId])
  @@index([originCompanyId, status, loadDate])
  @@index([destCompanyId, status, loadDate])
  @@index([producerCompanyId])
  @@index([participantCompanyIds], type: Gin)
  @@map("freights")
}

// ======================== FREIGHT ITEMS ==============================

model FreightItem {
  id               String   @id @default(uuid())
  freightId        String   @map("freight_id")
  // grain = product name snapshot — always preserved for display even if catalog product is renamed/deleted
  grain            String   @db.VarChar(100)
  companyProductId String?  @map("company_product_id") // nullable FK — set when product chosen from catalog
  tons             Decimal? @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  freight        Freight         @relation(fields: [freightId], references: [id], onDelete: Cascade)
  companyProduct CompanyProduct? @relation(fields: [companyProductId], references: [id], onDelete: SetNull)

  @@index([freightId])
  @@index([companyProductId])
  @@map("freight_items")
}

// ======================== FREIGHT ASSIGNMENTS =========================

model FreightAssignment {
  id                 String           @id @default(uuid())
  freightId          String           @map("freight_id")
  transportCompanyId String           @map("transport_company_id")
  status             AssignmentStatus @default(active)

  driverId   String? @map("driver_id")
  driverName String? @map("driver_name") @db.VarChar(255)
  plate      String? @db.VarChar(20)
  truckId    String? @map("truck_id")

  assignedById  String  @map("assigned_by_id")
  reason        String? @db.VarChar(255)
  queuePosition Int     @default(0) @map("queue_position")

  // External truck (third-party, not registered in system)
  isExternal          Boolean  @default(false) @map("is_external")
  externalCompanyName String?  @map("external_company_name") @db.VarChar(255)
  externalDriverName  String?  @map("external_driver_name") @db.VarChar(255)

  // Multi-truck trip lifecycle (v6.0)
  tripStatus                     TripStatus @default(pending) @map("trip_status")
  tripNumber                     Int        @default(1) @map("trip_number")
  tons                           Decimal?   @db.Decimal(10, 2)
  loadedTons                     Decimal?   @map("loaded_tons") @db.Decimal(10, 2)
  startedAt                      DateTime?  @map("trip_started_at")
  loadedAt                       DateTime?  @map("trip_loaded_at")
  finishedAt                     DateTime?  @map("trip_finished_at")
  transporterLoadedConfirmedAt   DateTime?  @map("trip_transporter_loaded_confirmed_at")
  producerLoadedConfirmedAt      DateTime?  @map("trip_producer_loaded_confirmed_at")
  transporterFinishedConfirmedAt DateTime?  @map("trip_transporter_finished_confirmed_at")
  plantFinishedConfirmedAt       DateTime?  @map("trip_plant_finished_confirmed_at")

  // Trip data (economics) — filled post-trip
  kmLoaded          Decimal?  @map("km_loaded") @db.Decimal(10, 1)
  kmEmpty           Decimal?  @map("km_empty") @db.Decimal(10, 1)
  kmTotal           Decimal?  @map("km_total") @db.Decimal(10, 1)
  departureAt       DateTime? @map("trip_departure_at")
  arrivalAt         DateTime? @map("trip_arrival_at")
  loadingMinutes    Int?      @map("loading_minutes")
  unloadingMinutes  Int?      @map("unloading_minutes")
  fuelLiters        Decimal?  @map("fuel_liters") @db.Decimal(10, 1)
  fuelCostPerLiter  Decimal?  @map("fuel_cost_per_liter") @db.Decimal(8, 2)
  tollCost          Decimal?  @map("toll_cost") @db.Decimal(12, 2)
  odometerStart     Int?      @map("odometer_start")
  odometerEnd       Int?      @map("odometer_end")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  freight          Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)
  transportCompany Company @relation("AssignmentTransporter", fields: [transportCompanyId], references: [id])
  assignedBy       User    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  driver           User?   @relation("AssignmentDriver", fields: [driverId], references: [id], onDelete: SetNull)
  truck            Truck?  @relation(fields: [truckId], references: [id], onDelete: SetNull)
  weighTickets     WeighTicket[]
  stockMovements   StockMovement[]

  @@index([freightId])
  @@index([freightId, tripStatus])
  @@index([transportCompanyId])
  @@index([transportCompanyId, status])
  @@index([truckId])
  @@index([driverId])
  @@index([driverId, status])
  @@index([assignedById])
  @@map("freight_assignments")
}

// ======================== FREIGHT DOCUMENTS ===========================

model FreightDocument {
  id           String        @id @default(uuid())
  freightId    String        @map("freight_id")
  name         String        @db.VarChar(255)
  url          String        @db.VarChar(500)
  type         String        @db.VarChar(50)
  step         DocumentStep?
  uploadedById String        @map("uploaded_by_id")
  ocrData      Json?         @map("ocr_data")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  freight    Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("uploadedDocuments", fields: [uploadedById], references: [id])

  @@index([freightId])
  @@index([freightId, step])
  @@index([uploadedById])
  @@map("freight_documents")
}

// ======================== WEIGH TICKETS ===============================

model WeighTicket {
  id             String   @id @default(uuid())
  freightId      String   @map("freight_id")
  assignmentId   String?  @map("assignment_id")
  type           String   @default("destination") @db.VarChar(20) // "origin" | "destination"
  ticketNumber   String?  @map("ticket_number") @db.VarChar(100)
  grossWeight    Decimal? @map("gross_weight") @db.Decimal(10, 2)
  tareWeight     Decimal? @map("tare_weight") @db.Decimal(10, 2)
  netWeight      Decimal? @map("net_weight") @db.Decimal(10, 2)
  humidity       Decimal? @db.Decimal(5, 2)
  impurities     Decimal? @db.Decimal(5, 2)
  dockage        Decimal? @db.Decimal(10, 2)
  temperature    Decimal? @db.Decimal(5, 2)
  observations   String?  @db.Text
  photoUrl       String?  @map("photo_url") @db.VarChar(500)
  ocrData        Json?    @map("ocr_data")
  ocrConfidence  Decimal? @map("ocr_confidence") @db.Decimal(3, 2)
  registeredById String   @map("registered_by_id")
  registeredAt   DateTime @default(now()) @map("registered_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  freight      Freight            @relation(fields: [freightId], references: [id], onDelete: Cascade)
  assignment   FreightAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  registeredBy User               @relation("WeighTicketRegisteredBy", fields: [registeredById], references: [id])

  @@index([freightId])
  @@index([assignmentId])
  @@index([ticketNumber])
  @@index([freightId, assignmentId, type])
  @@index([registeredById])
  @@map("weigh_tickets")
}

// ======================== FREIGHT TRACKING ============================

model FreightTracking {
  id        String   @id @default(uuid())
  freightId String   @map("freight_id")
  userId    String?  @map("user_id")
  lat       Decimal  @db.Decimal(10, 6)
  lng       Decimal  @db.Decimal(10, 6)
  speed     Decimal? @db.Decimal(6, 2)
  heading   Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  freight Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)

  @@index([freightId])
  @@index([createdAt])
  @@index([freightId, createdAt])
  @@index([freightId, userId, createdAt])
  @@map("freight_tracking")
}

// ======================== LIVE LOCATION (real-time sharing) ============

model LiveLocation {
  id        String   @id @default(uuid())
  freightId String   @map("freight_id")
  userId    String   @map("user_id")
  userName  String   @map("user_name") @db.VarChar(255)
  userRole  String   @map("user_role") @db.VarChar(30)
  lat       Decimal  @db.Decimal(10, 6)
  lng       Decimal  @db.Decimal(10, 6)
  speed     Decimal? @db.Decimal(6, 2)
  heading   Decimal? @db.Decimal(5, 2)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  freight Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)

  @@unique([freightId, userId])
  @@index([freightId, active])
  @@map("live_locations")
}

// ======================== CONVERSATIONS ===============================

model Conversation {
  id        String   @id @default(uuid())
  freightId String?  @unique @map("freight_id")
  createdAt DateTime @default(now()) @map("created_at")

  freight      Freight?                  @relation("FreightConversation", fields: [freightId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]

  @@map("conversations")
}

// ======================== CONVERSATION PARTICIPANTS ===================

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  companyId      String    @map("company_id")
  userId         String?   @map("user_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  lastReadAt     DateTime? @map("last_read_at")
  pinnedAt       DateTime? @map("pinned_at")
  markedUnread   Boolean   @default(false) @map("marked_unread")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation("conversationParticipations", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([conversationId, companyId])
  @@index([companyId])
  @@index([conversationId, userId])
  @@map("conversation_participants")
}

// ======================== MESSAGES ====================================

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  text           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ======================== AUDIT LOGS =================================

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") @db.VarChar(30)
  entityId   String   @map("entity_id")
  action     String   @db.VarChar(50)
  fromValue  String?  @map("from_value") @db.Text
  toValue    String?  @map("to_value") @db.Text
  userId     String   @map("user_id")
  freightId  String?  @map("freight_id")
  reason     String?  @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  freight Freight? @relation(fields: [freightId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([freightId])
  @@index([freightId, createdAt])
  @@map("audit_logs")
}

// ======================== STOCK / STORAGE ============================

model StockItem {
  id        String            @id @default(uuid())
  companyId String            @map("company_id")
  category  StockItemCategory
  name      String            @db.VarChar(255)
  code      String?           @db.VarChar(80)
  baseUnit  StockUnit         @map("base_unit")
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  balances  StockBalance[]

  @@unique([companyId, category, name])
  @@index([companyId, category, active])
  @@map("stock_items")
}

model StockLocation {
  id            String             @id @default(uuid())
  companyId     String             @map("company_id")
  locationType  StockLocationType  @map("location_type")
  ownershipType StockOwnershipType @map("ownership_type")
  name          String             @db.VarChar(255)
  referenceKey  String?            @map("reference_key") @db.VarChar(120)
  fieldId       String?            @map("field_id")
  lotId         String?            @map("lot_id")
  plantId       String?            @map("plant_id")
  address       String?            @db.VarChar(500)
  notes         String?            @db.Text
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  field         Field?           @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  lot           Lot?             @relation(fields: [lotId], references: [id], onDelete: SetNull)
  plant         Plant?           @relation(fields: [plantId], references: [id], onDelete: SetNull)
  incomingMoves StockMovement[]  @relation("StockMovementToLocation")
  outgoingMoves StockMovement[]  @relation("StockMovementFromLocation")
  balances      StockBalance[]

  @@unique([companyId, referenceKey])
  @@index([companyId, ownershipType, active])
  @@index([companyId, locationType, active])
  @@index([fieldId])
  @@index([lotId])
  @@index([plantId])
  @@map("stock_locations")
}

model StockMovement {
  id                String            @id @default(uuid())
  companyId         String            @map("company_id")
  itemId            String            @map("item_id")
  movementType      StockMovementType @map("movement_type")
  quantity          Decimal           @db.Decimal(14, 3)
  unit              StockUnit
  baseQuantity      Decimal           @map("base_quantity") @db.Decimal(14, 3)
  baseUnit          StockUnit         @map("base_unit")
  fromLocationId    String?           @map("from_location_id")
  toLocationId      String?           @map("to_location_id")
  effectiveAt       DateTime          @map("effective_at")
  notes             String?           @db.Text
  sourceType        StockSourceType   @default(manual) @map("source_type")
  sourceId          String?           @map("source_id") @db.VarChar(120)
  freightId         String?           @map("freight_id")
  assignmentId      String?           @map("assignment_id")
  isSystemGenerated Boolean           @default(false) @map("is_system_generated")
  metadata          Json?
  createdByUserId   String            @map("created_by_user_id")
  revertedAt        DateTime?         @map("reverted_at")
  revertedByUserId  String?           @map("reverted_by_user_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item         StockItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromLocation StockLocation?     @relation("StockMovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   StockLocation?     @relation("StockMovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  freight      Freight?           @relation(fields: [freightId], references: [id], onDelete: SetNull)
  assignment   FreightAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revertedBy   User?              @relation("StockMovementRevertedBy", fields: [revertedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, effectiveAt])
  @@index([companyId, movementType, effectiveAt])
  @@index([itemId, effectiveAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([sourceType, sourceId])
  @@index([freightId])
  @@index([assignmentId])
  @@map("stock_movements")
}

model StockBalance {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  itemId          String    @map("item_id")
  locationId      String    @map("location_id")
  currentQuantity Decimal   @map("current_quantity") @db.Decimal(14, 3)
  baseUnit        StockUnit @map("base_unit")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item     StockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([companyId, itemId, locationId])
  @@index([companyId, updatedAt])
  @@map("stock_balances")
}

// ======================== NOTIFICATIONS ===============================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  companyId String?          @map("company_id")
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String?          @db.VarChar(500)
  entityId  String?          @map("entity_id")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, read, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ======================== PUSH SUBSCRIPTIONS ===========================

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @db.Text
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ======================== USER-COMPANY MEMBERSHIPS ===================

model UserCompany {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  role            String   @default("operario") @db.VarChar(20)
  preferredModule String?  @map("preferred_module") @db.VarChar(20)
  active          Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([userId, active])
  @@map("user_companies")
}

// ======================== REFRESH TOKENS ==============================

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ======================== ANALYTICS ==================================
model AnalyticsEvent {
  id        String   @id @default(uuid())
  event     String   @db.VarChar(100)
  data      Json     @default("{}") // Prisma handles this correctly for PostgreSQL
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@index([event, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

// ======================== WHATSAPP =====================================

model WhatsAppSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  phone     String    @db.VarChar(50)
  flowType  String?   @map("flow_type") @db.VarChar(50)
  flowState Json?     @map("flow_state")
  flowStep  String?   @map("flow_step") @db.VarChar(50)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([phone, expiresAt])
  @@index([userId])
  @@index([userId, expiresAt])
  @@map("whatsapp_sessions")
}

model WhatsAppMessageLog {
  id          String   @id @default(uuid())
  waMessageId String?  @map("wa_message_id") @db.VarChar(100)
  phone       String   @db.VarChar(50)
  direction   String   @db.VarChar(10)
  type        String   @db.VarChar(30)
  content     Json?
  status      String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@index([waMessageId])
  @@index([createdAt])
  @@map("whatsapp_message_logs")
}

// ======================== PASSWORD RESET CODES ========================

model PasswordResetCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  resetJti  String?  @map("reset_jti")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

// ======================== FREIGHT PENDING CHANGES =======================

model FreightPendingChange {
  id                String    @id @default(uuid())
  freightId         String    @map("freight_id")
  changeType        String    @db.VarChar(50)
  fromValue         Json
  toValue           Json
  requestedById     String    @map("requested_by_id")
  approverCompanyId String    @map("approver_company_id")
  status            String    @default("pending") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at")
  resolvedAt        DateTime? @map("resolved_at")
  resolvedById      String?   @map("resolved_by_id")

  freight     Freight @relation(fields: [freightId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("PendingChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy  User?   @relation("PendingChangeResolver", fields: [resolvedById], references: [id])

  @@index([freightId, status])
  @@index([approverCompanyId, status])
  @@map("freight_pending_changes")
}

// ======================== SHARED LINKS ================================

enum SharedLinkType {
  FREIGHT
  PORTAL
  TICKET
}

enum LinkCreationChannel {
  WEB
  WHATSAPP
}

model SharedLink {
  id               String              @id @default(uuid())
  token            String              @unique
  linkType         SharedLinkType      @map("link_type")
  creatorCompanyId String              @map("creator_company_id")
  targetCompanyId  String              @map("target_company_id")
  freightId        String?             @map("freight_id")
  ticketId         String?             @map("ticket_id")
  createdById      String?             @map("created_by_id")
  createdVia       LinkCreationChannel @default(WEB) @map("created_via")
  expiresAt        DateTime?           @map("expires_at")
  revokedAt        DateTime?           @map("revoked_at")
  lastAccessedAt   DateTime?           @map("last_accessed_at")
  accessCount      Int                 @default(0) @map("access_count")
  createdAt        DateTime            @default(now()) @map("created_at")

  creatorCompany Company  @relation("SharedLinkCreator", fields: [creatorCompanyId], references: [id], onDelete: Cascade)
  targetCompany  Company  @relation("SharedLinkTarget", fields: [targetCompanyId], references: [id], onDelete: Cascade)
  freight        Freight? @relation(fields: [freightId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation("SharedLinkCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([creatorCompanyId, linkType])
  @@index([targetCompanyId, linkType])
  @@index([freightId])
  @@map("shared_links")
}

// ======================== MECHANIC MODULE ==============================

model MachineTemplate {
  id                   String   @id @default(uuid())
  brand                String   @db.VarChar(100)
  series               String?  @db.VarChar(100)
  model                String   @db.VarChar(100)
  machineType          String   @map("machine_type") @db.VarChar(50) // tractor, harvester, seeder, baler, implement, truck, car, motorcycle, other
  engineBrand          String?  @map("engine_brand") @db.VarChar(100)
  engineModel          String?  @map("engine_model") @db.VarChar(100)
  enginePower          String?  @map("engine_power") @db.VarChar(50)
  engineDisplacement   String?  @map("engine_displacement") @db.VarChar(50)
  transmissionType     String?  @map("transmission_type") @db.VarChar(100)
  fuelType             String?  @map("fuel_type") @db.VarChar(50)
  hydraulicSystem      String?  @map("hydraulic_system") @db.VarChar(100)
  maintenanceIntervals Json?    @map("maintenance_intervals")
  specs                Json?
  machines             Machine[]
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([brand, model, machineType])
  @@map("machine_templates")
}

model Machine {
  id                   String   @id @default(uuid())
  companyId            String   @map("company_id")
  company              Company  @relation(fields: [companyId], references: [id])
  templateId           String?  @map("template_id")
  template             MachineTemplate? @relation(fields: [templateId], references: [id])

  machineType          String   @map("machine_type") @db.VarChar(50)
  brand                String   @db.VarChar(100)
  model                String   @db.VarChar(100)
  year                 Int?
  serialNumber         String   @map("serial_number") @db.VarChar(100)

  engineBrand          String?  @map("engine_brand") @db.VarChar(100)
  engineModel          String?  @map("engine_model") @db.VarChar(100)
  enginePower          String?  @map("engine_power") @db.VarChar(50)
  engineDisplacement   String?  @map("engine_displacement") @db.VarChar(50)
  transmissionType     String?  @map("transmission_type") @db.VarChar(100)
  fuelType             String?  @map("fuel_type") @db.VarChar(50)
  hydraulicSystem      String?  @map("hydraulic_system") @db.VarChar(100)
  hydraulicCapacity    String?  @map("hydraulic_capacity") @db.VarChar(50)
  tireSize             String?  @map("tire_size") @db.VarChar(50)
  tireBrand            String?  @map("tire_brand") @db.VarChar(50)
  currentHorometer     Float?   @map("current_horometer")
  currentOdometer      Float?   @map("current_odometer")

  qrCode               String?  @unique @map("qr_code")
  photos               Json?

  modifications        MachineModification[]
  repairHistory        MachineRepairHistory[]
  maintenanceRecords   MaintenanceRecord[]
  maintenancePlan      MaintenancePlan?
  maintenanceAlerts    MaintenanceAlert[]
  diagnosticSessions   DiagnosticSession[]

  status               String   @default("active") @db.VarChar(20) // active, inactive, sold
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([companyId, serialNumber])
  @@index([companyId])
  @@map("machines")
}

model MachineModification {
  id          String    @id @default(uuid())
  machineId   String    @map("machine_id")
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  description String
  date        DateTime?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([machineId])
  @@map("machine_modifications")
}

model MachineRepairHistory {
  id          String    @id @default(uuid())
  machineId   String    @map("machine_id")
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  description String
  date        DateTime?
  workshop    String?
  cost        Float?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([machineId])
  @@map("machine_repair_history")
}

model MaintenanceRecord {
  id               String   @id @default(uuid())
  machineId        String   @map("machine_id")
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId        String   @map("company_id")

  type             String   @db.VarChar(50) // scheduled_service, repair, part_change, inspection
  date             DateTime
  horometerReading Float?   @map("horometer_reading")
  odometerReading  Float?   @map("odometer_reading")
  description      String
  partsUsed        Json?    @map("parts_used")
  laborCost        Float?   @map("labor_cost")
  totalCost        Float?   @map("total_cost")
  workshop         String?
  mechanic         String?
  documents        Json?
  notes            String?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([machineId])
  @@index([companyId])
  @@map("maintenance_records")
}

model MaintenancePlan {
  id               String   @id @default(uuid())
  machineId        String   @unique @map("machine_id")
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId        String   @map("company_id")

  intervals        Json     // [{ type, label, hours, months }]
  customIntervals  Json?    @map("custom_intervals")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("maintenance_plans")
}

model MaintenanceAlert {
  id               String   @id @default(uuid())
  machineId        String   @map("machine_id")
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId        String   @map("company_id")

  type             String   @db.VarChar(30) // hours_based, time_based
  maintenanceType  String   @map("maintenance_type") @db.VarChar(50) // oil_change, filters, major_service, etc.
  label            String   @db.VarChar(100)
  message          String
  severity         String   @default("warning") @db.VarChar(20) // warning, overdue
  dueDate          DateTime? @map("due_date")
  dueHorometer     Float?   @map("due_horometer")
  status           String   @default("pending") @db.VarChar(20) // pending, acknowledged, completed, dismissed

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([machineId])
  @@index([companyId, status])
  @@map("maintenance_alerts")
}

model MachineManual {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  machineId   String?  @map("machine_id")
  title       String   @db.VarChar(200)
  content     String   @db.Text
  keywords    String?  @db.Text
  fileUrl     String?  @map("file_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([machineId])
  @@map("machine_manuals")
}

model DiagnosticSession {
  id              String    @id @default(uuid())
  machineId       String    @map("machine_id")
  machine         Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId       String    @map("company_id")
  userId          String    @map("user_id")

  title           String?
  status          String    @default("open") @db.VarChar(20) // open, resolved, unresolved
  resolutionNotes String?   @map("resolution_notes")
  messages        Json      @default("[]")

  shareToken      String?   @unique @map("share_token")
  shareExpiresAt  DateTime? @map("share_expires_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([machineId])
  @@index([companyId])
  @@map("diagnostic_sessions")
}

model VerifiedPart {
  id              String    @id @default(uuid())
  partNumber      String    @map("part_number") @db.VarChar(50)
  brand           String    @db.VarChar(100)
  description     String
  category        String?   @db.VarChar(50)
  machineModels   Json?     @map("machine_models")
  source          String    @db.VarChar(100)
  sourceUrl       String?   @map("source_url")
  diagramUrl      String?   @map("diagram_url")
  crossReferences Json?     @map("cross_references")
  lastKnownPrice  String?   @map("last_known_price")
  priceCurrency   String?   @default("USD") @map("price_currency") @db.VarChar(10)
  priceDate       DateTime? @map("price_date")
  verifiedByUser  Boolean   @default(false) @map("verified_by_user")
  verifiedAt      DateTime? @map("verified_at")
  timesUsed       Int       @default(0) @map("times_used")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([partNumber, brand])
  @@index([brand, category])
  @@map("verified_parts")
}


// ======================== COMPANY PRODUCT CATALOG ====================
// Each company maintains its own list of products (grains, commodities, etc.)
// Used in freight creation. Products cannot be hard-deleted if referenced by freights.

model CompanyProduct {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  name        String   @db.VarChar(100)
  code        String?  @db.VarChar(20)
  defaultUnit String?  @map("default_unit") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  freightItems FreightItem[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("company_products")
}
